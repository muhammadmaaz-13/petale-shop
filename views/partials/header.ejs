<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title><%= title %></title>
<meta name="description" content="<%= metaDescription %>">
<meta name="theme-color" content="#5c2340">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="announce-bar" id="announceBar">
  <div class="announce-track">
    <% [...siteConfig.announcements, ...siteConfig.announcements].forEach(msg => { %>
      <span class="announce-item"><%= msg %></span>
    <% }) %>
  </div>
</div>

<header id="siteHeader">
  <nav>
    <a href="/" class="logo"><span class="dot"></span>Petalé</a>

    <ul class="nav-links">
      <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
      <li><a href="/shop" class="<%= currentPath.startsWith('/shop') ? 'active' : '' %>">Shop All</a></li>
      <li class="has-mega">
        <a href="/shop">Shop By ▾</a>
        <div class="mega-menu">
          <a href="/shop" class="mega-item">All products</a>
          <% allCategories.forEach(cat => { %>
            <a href="/shop?category=<%= cat %>" class="mega-item"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></a>
          <% }) %>
        </div>
      </li>
      <li><a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a></li>
      <li><a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>
    </ul>

    <div class="nav-right">
      <a class="phone-link" href="tel:<%= siteConfig.phone.tel %>" aria-label="Call us at <%= siteConfig.phone.display %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <span class="phone-link-label"><%= siteConfig.phone.display %></span>
      </a>
      <button class="icon-btn" id="searchBtn" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </button>
      <button class="cart-btn" id="cartBtn" aria-label="Open cart">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span class="cart-count <%= cartCount > 0 ? 'show' : '' %>" id="cartCount"><%= cartCount %></span>
      </button>
      <button class="icon-btn menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>
</header>

<!-- Simple search overlay -->
<div class="search-overlay" id="searchOverlay">
  <form class="search-box" action="/shop" method="GET">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
    <input type="text" name="q" placeholder="Search products..." autofocus>
  </form>
  <button class="search-close" id="searchClose">✕</button>
</div>

<!-- Mobile menu (shown under 900px via the hamburger button) -->
<div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>
<nav class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu-head">
    <a href="/" class="logo"><span class="dot"></span>Petalé</a>
    <button class="close-drawer" id="mobileMenuClose" aria-label="Close menu">✕</button>
  </div>
  <ul class="mobile-nav-links">
    <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
    <li><a href="/shop" class="<%= currentPath.startsWith('/shop') ? 'active' : '' %>">Shop All</a></li>
    <% allCategories.forEach(cat => { %>
      <li><a href="/shop?category=<%= cat %>" class="mobile-sub-link"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></a></li>
    <% }) %>
    <li><a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a></li>
    <li><a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>
  </ul>
  <a class="mobile-menu-phone" href="tel:<%= siteConfig.phone.tel %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    Call <%= siteConfig.phone.display %>
  </a>
</nav>
